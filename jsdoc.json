{
  "tags": {
    "allowUnknownTags": true
  },
  "source": {
    "include": ["./"],
    "exclude": ["node_modules", "docs"],
    "includePattern": ".+\\.js(doc)?$",
    "excludePattern": "(^|\\/|\\\\)_"
  },
  "plugins": [],
  "templates": {
    "cleverLinks": false,
    "monospaceLinks": false
  },
  "opts": {
    "recurse": true,
    "private": true,
    "destination": "./docs/",
    "template": "node_modules/docdash"
  }
}
